<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="428px"
    android:layout_height="142px"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/scan_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/terminal_qr_scan_icon" />

        <TextView
            android:id="@+id/scan_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR"
            android:textColor="#CFE2F9"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp" />

        <ImageView
            android:id="@+id/send_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/terminal_sending_icon" />

        <TextView
            android:id="@+id/send_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textColor="#CFE2F9"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</FrameLayout> 