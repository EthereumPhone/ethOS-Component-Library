<?xml version="1.0" encoding="utf-8"?>
<app.grapheneos.camera.ui.SettingsFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background dim overlay that dismisses the dialog when tapped -->
    <View
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main settings card -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/SettingsDialogCard"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/settings_dialog_max_width">

            <!-- More Settings temporarily disabled due to text color issues
            <TextView
                android:id="@+id/more_settings"
                style="@style/SettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/settings_bg"
                android:foreground="@drawable/more_settings_bg"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text="@string/more_settings"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/video_quality_setting" />
            -->

            <TextView
                android:id="@+id/setting_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/spacemono_bold"
                android:text="CAMERA SETTINGS"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="@+id/dismissButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/dismissButton" />

            <app.grapheneos.camera.ui.ToggleImageButton
                android:id="@+id/location_toggle"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/torch_accent"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/location_toggle_icon"
                android:tint="?attr/colorOnPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/setting_title" />

            <app.grapheneos.camera.ui.ToggleImageButton
                android:id="@+id/aspect_ratio_toggle"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/aspect_ratio_accent"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/aspect_ratio_toggle_icon"
                android:tint="?attr/colorOnPrimary"
                app:layout_constraintStart_toEndOf="@id/location_toggle"
                app:layout_constraintTop_toTopOf="@id/location_toggle" />

            <app.grapheneos.camera.ui.ToggleImageButton
                android:id="@+id/torch_toggle_option"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/location_accent"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/torch_toggle_icon"
                android:tint="?attr/colorOnPrimary"
                app:layout_constraintStart_toEndOf="@id/aspect_ratio_toggle"
                app:layout_constraintTop_toTopOf="@id/location_toggle" />

            <FrameLayout
                android:id="@+id/flash_toggle_container"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                app:layout_constraintStart_toEndOf="@+id/grid_toggle_container"
                app:layout_constraintTop_toTopOf="@+id/location_toggle">

                <app.grapheneos.camera.ui.ToggleImageButton
                    android:id="@+id/flash_toggle_option"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:padding="0dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/flash_off_circle"
                    android:tint="@null" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/grid_toggle_container"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                app:layout_constraintStart_toEndOf="@id/torch_toggle_option"
                app:layout_constraintTop_toTopOf="@id/location_toggle">

                <app.grapheneos.camera.ui.ToggleImageButton
                    android:id="@+id/grid_toggle_option"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:padding="0dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/grid_off_circle"
                    android:tint="@null" />

            </FrameLayout>

            <RelativeLayout
                android:id="@+id/relativeLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_dialog_menu_item_height"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/settings_dialog_menu_item_horizontal"
                android:paddingVertical="@dimen/settings_dialog_menu_item_vertical"
                app:layout_constraintTop_toBottomOf="@+id/location_toggle"
                tools:layout_editor_absoluteX="-37dp">

                <TextView
                    android:id="@+id/optimize_for_label"
                    style="@style/SettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center_vertical|start"
                    android:text="@string/optimize_for" />

                <app.grapheneos.camera.ui.CustomRadioGroup
                    android:id="@+id/cm_radio_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <app.grapheneos.camera.ui.CustomRadioButton
                        android:id="@+id/quality_radio"
                        checked="true"
                        text="@string/quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp" />

                    <app.grapheneos.camera.ui.CustomRadioButton
                        android:id="@+id/latency_radio"
                        checked="false"
                        text="@string/latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </app.grapheneos.camera.ui.CustomRadioGroup>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/include_audio_setting"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_dialog_menu_item_height"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/settings_dialog_menu_item_horizontal"
                android:paddingVertical="@dimen/settings_dialog_menu_item_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/relativeLayout">

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/include_audio" />

                <app.grapheneos.camera.ui.CustomSquareSwitch
                    android:id="@+id/include_audio_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/settings_dialog_switch_height"
                    android:checked="true" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/self_illumination_setting"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_dialog_menu_item_height"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/settings_dialog_menu_item_horizontal"
                android:paddingVertical="@dimen/settings_dialog_menu_item_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/include_audio_setting">

                <TextView
                    android:id="@+id/textView2"
                    style="@style/SettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:text="@string/self_illumination"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <app.grapheneos.camera.ui.CustomSquareSwitch
                    android:id="@+id/self_illumination_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/settings_dialog_switch_height"
                    android:checked="false"
                    app:layout_constraintBottom_toBottomOf="@+id/textView2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/textView2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/enable_eis_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/settings_dialog_menu_item_horizontal"
                android:paddingVertical="@dimen/settings_dialog_menu_item_vertical"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/self_illumination_setting">

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/enable_eis" />

                <LinearLayout
                    android:id="@+id/enable_eis_switch_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical">

                    <app.grapheneos.camera.ui.CustomSquareSwitch
                        android:id="@+id/enable_eis_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/settings_dialog_switch_height"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dropdown/Spinner settings moved to the end -->
            <LinearLayout
                android:id="@+id/timer_setting"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_dialog_menu_item_height"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/settings_dialog_menu_item_horizontal"
                android:paddingVertical="@dimen/settings_dialog_menu_item_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/enable_eis_setting">

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/timer" />

                <Spinner
                    android:id="@+id/timer_spinner"
                    style="@style/SettingsSpinner"
                    android:layout_gravity="center_vertical"
                    android:checked="true" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_dialog_menu_item_height"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/settings_dialog_menu_item_horizontal"
                android:paddingVertical="@dimen/settings_dialog_menu_item_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/timer_setting">

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/focus_timeout" />

                <Spinner
                    android:id="@+id/focus_timeout_spinner"
                    style="@style/SettingsSpinner"
                    android:layout_gravity="center_vertical"
                    android:checked="true" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/video_quality_setting"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_dialog_menu_item_height"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/settings_dialog_menu_item_horizontal"
                android:paddingVertical="@dimen/settings_dialog_menu_item_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout">

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/video_quality" />

                <Spinner
                    android:id="@+id/video_quality_spinner"
                    style="@style/SettingsSpinner"
                    android:layout_gravity="center_vertical"
                    android:checked="true" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/dismissButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-8dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/cancel" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Placeholder views to satisfy existing Kotlin references while UI is reworked -->
    <FrameLayout
        android:id="@+id/settingsDialog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/settingsFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/settingsScrollview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsScrollviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/include_audio_switch_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/self_illumination_switch_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone" />

</app.grapheneos.camera.ui.SettingsFrameLayout>