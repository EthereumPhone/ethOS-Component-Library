<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CustomRadioButton">
        <attr name="text" format="string" />
        <attr name="checked" format="boolean" />
    </declare-styleable>
    
    <declare-styleable name="CustomSquareSwitch">
        <attr name="text" />
        <attr name="checked" />
    </declare-styleable>
    
    <!-- Shape appearance attributes -->
    <attr name="cornerFamily" format="enum">
        <enum name="rounded" value="0" />
        <enum name="cut" value="1" />
    </attr>
    <attr name="cornerSize" format="dimension|fraction" />
    
    <!-- Material3 color attributes -->
    <attr name="colorSecondary" format="color" />
    <attr name="colorOnSurface" format="color" />
    <attr name="colorOnPrimary" format="color" />
</resources>