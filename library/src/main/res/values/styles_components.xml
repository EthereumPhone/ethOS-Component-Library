<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Component Styles for Consistent UI Elements -->
    
    <!-- Header Title Style -->
    <style name="ComponentHeaderTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/spacemono_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
    </style>
    
    <!-- Header Dismiss Button Style -->
    <style name="ComponentHeaderDismissButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginEnd">-8dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:src">@drawable/cancel</item>
        <item name="android:tint">?attr/colorPrimary</item>
    </style>
    
    <!-- Settings Dismiss Button Style (smaller) -->
    <style name="ComponentSettingsDismissButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">-8dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:src">@drawable/cancel</item>
        <item name="android:tint">?attr/colorPrimary</item>
    </style>
    
    <!-- Toggle Button Style -->
    <style name="ComponentToggleButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/colorPrimary</item>
    </style>
    
    <!-- Label Row Container Style -->
    <style name="ComponentLabelRowContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_dialog_menu_item_height</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/settings_dialog_menu_item_horizontal</item>
        <item name="android:paddingVertical">@dimen/settings_dialog_menu_item_vertical</item>
    </style>
    
    <!-- Label EditText Container Style -->
    <style name="ComponentLabelEditTextContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">-1dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">@dimen/settings_dialog_menu_item_horizontal</item>
        <item name="android:paddingVertical">@dimen/settings_dialog_menu_item_vertical</item>
    </style>
    
    <!-- Label Value Container Style (for Chain) -->
    <style name="ComponentLabelValueContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_dialog_menu_item_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginStart">-1dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">@dimen/settings_dialog_menu_item_horizontal</item>
        <item name="android:paddingVertical">@dimen/settings_dialog_menu_item_vertical</item>
    </style>
    
    <!-- Terminal Text Style -->
    <style name="terminal_text">
        <item name="android:fontFamily">@font/monomaniac</item>
        <item name="android:textColor">@color/dgen_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    
</resources>
